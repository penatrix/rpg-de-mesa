{
  "name": "@rpg/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && concurrently -n tsc,srv -c gray,cyan \"tsc -b -w --preserveWatchOutput\" \"node --watch dist/index.js\"",
    "start": "node dist/index.js",
    "test": "tsc -b && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "@rpg/shared": "*",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  }
}
