# Chave da API da Anthropic — habilita o Mestre IA.
# Pegue em https://console.anthropic.com → API Keys → Create Key
# (é preciso ter créditos em Billing; o uso é cobrado por token).
#
# Cole a chave logo depois do sinal de igual, sem aspas e sem espaços:
#   ANTHROPIC_API_KEY=sk-ant-...
#
# Sem ela a plataforma continua funcionando com o Mestre Offline (roteirizado).
# Este arquivo nunca vai para o repositório. Nunca compartilhe a chave.
ANTHROPIC_API_KEY=

# Modelo usado pelo Mestre IA.
RPG_GM_MODEL=claude-opus-5

# Nível de esforço do Mestre IA: low | medium | high | xhigh | max
# "medium" equilibra qualidade narrativa e latência de mesa.
RPG_GM_EFFORT=medium

# Porta do servidor (o cliente Vite roda em 5173 e faz proxy para cá).
PORT=8787

# Caminho do banco SQLite.
RPG_DB_PATH=./data/rpg.db
