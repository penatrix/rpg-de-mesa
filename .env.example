# Chave da API da Anthropic — habilita o Mestre IA.
# Pegue em https://console.anthropic.com → API Keys → Create Key
# (é preciso ter créditos em Billing; o uso é cobrado por token).
#
# Cole a chave logo depois do sinal de igual, sem aspas e sem espaços:
#   ANTHROPIC_API_KEY=sk-ant-...
#
# Sem ela a plataforma continua funcionando com o Mestre Offline (roteirizado).
# Este arquivo nunca vai para o repositório. Nunca compartilhe a chave.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Custo do Mestre IA
#
# Numa mesa, o Mestre faz uma chamada à API por ferramenta que usa: um combate
# com invocação, iniciativa, dano e narração são várias idas e voltas por ação
# sua. Os padrões abaixo foram escolhidos para uma mesa custar centavos por
# sessão; subir qualquer um deles sobe a conta.
# ---------------------------------------------------------------------------

# Modelo do Mestre. Sonnet narra bem e custa uma fração do Opus neste regime
# de muitas chamadas curtas. Para gastar ainda menos, use claude-haiku-4-5 —
# a narração fica mais simples, o custo cai a cerca de um terço.
RPG_GM_MODEL=claude-sonnet-5

# Esforço: low | medium | high | xhigh | max
# Narrar três frases e aplicar dano não é problema de raciocínio, e o esforço
# é cobrado como saída — o token mais caro da conta.
RPG_GM_EFFORT=low

# Pensamento estendido (1 liga). Melhora a calibragem de combates difíceis e
# multiplica o custo de saída. Desligado por padrão.
RPG_GM_THINKING=0

# Teto de saída por chamada. Uma narração de mesa tem 2 a 6 frases.
RPG_GM_MAX_TOKENS=1600

# Ferramentas encadeadas por turno. Cada uma é uma chamada à API.
RPG_GM_MAX_ITERATIONS=8

# Entradas de log enviadas ao Mestre a cada turno. A memória longa é a crônica,
# que custa muito menos que reenviar o histórico.
RPG_GM_LOG_WINDOW=10

# Teto de gasto por mesa, em centavos de dólar (100 = US$ 1,00; 0 = sem teto).
# Ao atingir o teto o Mestre IA para e a mesa segue com Mestre humano.
RPG_TABLE_BUDGET_CENTS=100

# Preços por milhão de tokens, em dólares. Só para a estimativa exibida na
# mesa — a conta oficial é a do painel da Anthropic. Ajuste se os preços
# mudarem; deixe em branco para usar a tabela embutida.
# RPG_PRICE_INPUT=3
# RPG_PRICE_OUTPUT=15
# RPG_PRICE_CACHE_WRITE=3.75
# RPG_PRICE_CACHE_READ=0.3

# ---------------------------------------------------------------------------

# Porta do servidor (o cliente Vite roda em 5173 e faz proxy para cá).
PORT=8787

# Caminho do banco SQLite.
RPG_DB_PATH=./data/rpg.db
